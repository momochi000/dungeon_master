{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        org.neo4j.driver/neo4j-java-driver {:mvn/version "5.15.0"}
        net.clojars.wkok/openai-clojure {:mvn/version "0.22.0"}
        cheshire/cheshire {:mvn/version "5.12.0"} ; json
        lynxeyes/dotenv {:mvn/version "1.1.0"} ; .env file support
        io.github.clojure/tools.logging {:git/tag "v1.3.0" :git/sha "be30369b2fcf5403ae75cebbc9e645046525f437"}
        ;;environ {:mvn/version "1.2.0"}} ; environment variable management
       }

 :aliases {;; Run with clj -T:build function-in-build
           :build {:deps {
                          io.github.clojure/tools.build {:git/tag "v0.10.7" :git/sha "573711e"}
                          }
                          ;;{io.github.clojure/tools.build {:mvn/version "0.10.7"}}
                   :ns-default build }
           :nREPL {:extra-deps {
                                nrepl/nrepl {:mvn/version "1.3.1"}
                                org.clojure/tools.namespace {:mvn/version "1.5.0"}}}
                                ;;io.github.clojure/tools.namespace {:git/tag "1.5.0" :git/sha "01efab934ce23f61a3e5c82567bdfc1e22e74d03"}}}
           :dev {:extra-paths ["target/classes"]}
 }}
